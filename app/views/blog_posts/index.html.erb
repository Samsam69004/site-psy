<% content_for :meta_title, "Blog | Frédérique Granjon, psychopraticienne à Lyon 6" %>
<% content_for :meta_description, "Le blog de Frédérique Granjon : des articles sur la thérapie psychocorporelle, l’APsySE, les émotions et le bien-être à Lyon." %>

<main class="bg-gradient-to-br from-green-50 via-white to-orange-50 font-sans text-green-900">
  <section class="mx-auto mt-8 w-[calc(100%-2rem)] rounded-xl bg-white px-5 py-10 shadow-xl sm:px-8 sm:py-12" style="max-width: 900px;">
    <div class="text-center">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-green-600">Blog · Frédérique Granjon</p>
      <h1 class="font-serif text-4xl font-bold uppercase text-green-800 md:text-5xl">Articles et réflexions</h1>
      <span class="mx-auto mt-5 block h-1 w-16 bg-green-600"></span>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-green-800">
        Des articles autour de la thérapie psychocorporelle, de l’APsySE, du corps et des émotions.
      </p>
    </div>

    <div class="mt-10 space-y-5">
      <% @blog_posts.each_with_index do |blog_post, index| %>
        <article class="group flex flex-col items-stretch gap-5 rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg sm:flex-row sm:items-center sm:gap-6">
          <%= link_to blog_post_path(blog_post[:slug]),
            class: "flex h-44 w-full flex-shrink-0 items-center justify-center overflow-hidden rounded-xl bg-[#f9f9f6] shadow-md sm:w-60",
            aria: { label: "Lire l’article #{blog_post[:title]}" } do %>
            <%= image_tag blog_post[:image],
              alt: "Lire l’article : #{blog_post[:title]}",
              class: "h-full w-full rounded-xl object-cover transition duration-300 group-hover:scale-105" %>
          <% end %>
          <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold uppercase tracking-wider text-green-600"><%= blog_post[:published_at].strftime("%d/%m/%Y") %></p>
            <h2 class="mt-2 font-serif text-2xl font-bold leading-tight text-green-800 md:text-3xl">
              <%= link_to blog_post[:title], blog_post_path(blog_post[:slug]), class: "group-hover:text-green-600" %>
            </h2>
            <p class="mt-3 text-green-800"><%= blog_post[:excerpt] %></p>
            <%= link_to "Lire l’article →", blog_post_path(blog_post[:slug]),
              class: "mt-5 font-semibold text-green-600 underline hover:text-green-800" %>
          </div>
        </article>
        <% unless index == @blog_posts.length - 1 %>
          <div class="my-5 overflow-hidden rounded-md shadow-sm">
            <%= render "shared/frange", position: index.even? ? "35%" : "65%" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
  <div class="h-16"></div>
</main>
