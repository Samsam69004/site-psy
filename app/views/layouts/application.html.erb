<!DOCTYPE html>
<html lang="fr">
  <head>
    <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-3KPNC53Z59"></script>
  <script nonce="<%= content_security_policy_nonce %>">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-3KPNC53Z59');
  </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- SEO -->
    <title><%= content_for(:meta_title) || "Frédérique Granjon – Thérapie psychocorporelle à Lyon 6" %></title>
    <meta name="description" content="<%= content_for(:meta_description) || "Frédérique Granjon, psychopraticienne à Lyon 6, propose un accompagnement en thérapie psychocorporelle et en Analyse Psycho Somato Énergétique (APsySE)." %>">
    <meta name="author" content="Frédérique Granjon">
    <link rel="canonical" href="<%= request.base_url + request.path %>">

    <!-- Open Graph (réseaux sociaux, SEO enrichi) -->
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="Frédérique Granjon – Psychopraticienne à Lyon">
    <meta property="og:title" content="<%= content_for(:meta_title) || "Frédérique Granjon – Thérapie psychocorporelle à Lyon 6" %>">
    <meta property="og:description" content="<%= content_for(:meta_description) || "Accompagnement en thérapie psychocorporelle et Analyse Psycho Somato Énergétique (APsySE), au cabinet à Lyon 6." %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.base_url + request.path %>">
    <meta property="og:image" content="<%= request.base_url + image_path('og-image.jpg') %>">
    <meta property="og:image:alt" content="Frédérique Granjon, psychopraticienne à Lyon 6">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for(:meta_title) || "Frédérique Granjon – Thérapie psychocorporelle à Lyon 6" %>">
    <meta name="twitter:description" content="<%= content_for(:meta_description) || "Accompagnement en thérapie psychocorporelle et Analyse Psycho Somato Énergétique (APsySE)." %>">
    <meta name="twitter:image" content="<%= request.base_url + image_path('og-image.jpg') %>">

    <!-- Robots -->
    <meta name="robots" content="index, follow">

    <% if content_for?(:structured_data) %>
      <script type="application/ld+json" nonce="<%= content_security_policy_nonce %>">
        <%= raw content_for(:structured_data) %>
      </script>
    <% else %>
    <script type="application/ld+json" nonce="<%= content_security_policy_nonce %>">
      <%= raw json_escape({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "@id": "#{request.base_url}/#professional-service",
        "name": "Frédérique Granjon – Psychopraticienne",
        "url": request.base_url,
        "image": "#{request.base_url}#{image_path('og-image.jpg')}",
        "description": "Accompagnement en thérapie psychocorporelle et Analyse Psycho Somato Énergétique (APsySE) à Lyon 6.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "11-13 rue Curie",
          "postalCode": "69006",
          "addressLocality": "Lyon",
          "addressCountry": "FR"
        },
        "areaServed": [
          { "@type": "City", "name": "Lyon" },
          { "@type": "AdministrativeArea", "name": "Lyon 6e arrondissement" }
        ],
        "sameAs": [
          "https://www.psychologue.net/cabinets/frederique-granjon",
          "https://www.resalib.fr/praticien/37941-frederique-granjon-psychopraticien-lyon",
          "https://www.apsyse.com/"
        ]
      }.to_json) %>
    </script>
    <% end %>

    <!-- Tailwind CSS -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload", media: "all" %>

    <!-- JS Modern -->
    <%= javascript_include_tag "application", type: "module", "data-turbo-track": "reload" %>

    <!-- JS fallback pour anciens navigateurs -->
    <%= javascript_include_tag "legacy", nomodule: true %>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Source+Serif+Pro:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <%= favicon_link_tag 'favicon.ico', rel: 'shortcut icon', type: 'image/x-icon' %>
    <%= tag.link rel: "manifest", href: "/site.webmanifest" %>
  </head>

  <body class="relative text-gray-800">
    <!-- Message pour navigateurs non supportés -->
    <noscript>
      <div style="background: #fee; color: #b00; padding: 1rem; text-align: center;">
        Votre navigateur ne prend pas en charge JavaScript ou est trop ancien pour afficher ce site correctement.
        Veuillez le mettre à jour pour une meilleure expérience.
      </div>
    </noscript>

    <div class="absolute inset-0 z-0 bg-no-repeat bg-cover" style="background-image: url('<%= image_path("papier-peint.jpg") %>'); opacity: 0.04;"></div>

    <main class="relative z-10">
      <!-- Navbar -->
      <header class="fixed top-0 left-0 w-full z-50 bg-green-600 shadow-md text-white">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between px-4 py-3">
          <%= image_tag "logomaman.png", alt: "Logo Frédérique Granjon", class: "h-10 w-auto mr-4" %>

          <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm sm:text-base text-white text-center w-full sm:w-auto">
            <% ["accueil", "parcours", "outils", "cabinet", "cequejepropose", "avis", "contact"].each do |section| %>
              <%= link_to section.upcase.gsub("CEQUEJEPROPOSE", "CE QUE JE PROPOSE"), root_path(anchor: section),
                class: "block relative pb-1 hover:text-white transition duration-300 after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-[2px] after:w-0 after:bg-white after:transition-all after:duration-300 hover:after:w-full",
                aria: { label: "Aller à la section #{section}" } %>
            <% end %>
            <%= link_to "BLOG", blog_path,
              class: "block relative pb-1 hover:text-white transition duration-300 after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-[2px] after:w-0 after:bg-white after:transition-all after:duration-300 hover:after:w-full",
              aria: { label: "Lire le blog de Frédérique Granjon" } %>
          </nav>
        </div>
      </header>

      <!-- Main content -->
      <div class="pt-24">
        <%= yield %>
      </div>

      <!-- Flash messages -->
      <% if notice %>
        <div class="flash-notice text-white bg-green-500 py-2 text-center">
          <%= notice %>
        </div>
      <% end %>
      <% if alert %>
        <div id="flash-alert" class="text-white bg-red-500 py-2 text-center">
          <%= alert %>
        </div>
      <% end %>

      <!-- Footer -->
      <footer class="bg-white border-t border-gray-200 text-center text-sm text-green-800 py-6 shadow-inner">
        <p class="mb-1">
          Site réalisé par
          <a href="https://www.linkedin.com/in/sami-chabane-085881151/" target="_blank" rel="noopener" class="text-green-600 font-semibold hover:underline">
            Sami Chabane
          </a> — Développeur web full stack 💻
        </p>
        <p class="mb-1">&copy; <%= Time.current.year %> Frédérique Granjon — Tous droits réservés.</p>
        <p class="mb-1">SIRET : <span class="font-semibold">81917677700012</span></p>
        <div class="space-x-4 mt-2">
          <%= link_to "Mentions légales", mentions_legales_path, class: "underline hover:text-green-600" %>
          <%= link_to "Politique de confidentialité", politique_confidentialite_path, class: "underline hover:text-green-600" %>
        </div>
        <nav aria-label="Blog" class="mt-3">
          <%= link_to "Blog", blog_path, class: "underline hover:text-green-600" %>
        </nav>
      </footer>

      <!-- Bouton retour haut -->
      <button id="backToTop"
              class="fixed bottom-6 right-6 z-50 hidden bg-green-600 text-white px-4 py-3 rounded-full shadow-lg hover:bg-green-700 transition duration-300 text-sm sm:text-base flex items-center gap-2"
              title="Retour en haut">
        <span>🔝</span>
        <span class="hidden sm:inline">Haut</span>
      </button>

      <script nonce="<%= content_security_policy_nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
          const btn = document.getElementById("backToTop");
          btn.addEventListener("click", function () {
            window.scrollTo({ top: 0, behavior: "smooth" });
          });
          window.addEventListener("scroll", function () {
            btn.classList.toggle("hidden", window.scrollY < 300);
          });
        });
      </script>
    </main>
  </body>
</html>
